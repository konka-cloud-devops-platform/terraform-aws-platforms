{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowReadAccessToNginxConf",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::ullagalliu-artifacts/conf/nginx.conf"
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::ullagalliu-artifacts", 
                "arn:aws:s3:::ullagalliu-artifacts/frontend/*"
            ]
        }
    ]
}